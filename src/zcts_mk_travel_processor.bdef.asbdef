projection;
//strict ( 2 );
use draft;

define behavior for ZCTS_MK_Travel_Processor alias Travel
{
  use create;
  use update;
  use delete;

//  use action copyTravel;

  use association _Booking { create; with draft; }

}

define behavior for ZCTS_MK_Booking_Processor alias booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Bookingsupplement { create; with draft; }
}

define behavior for ZCTS_MK_Boosuppl_Processor alias BookingSupplement
{
  use update;
  use delete;

  use association _Booking { with draft; }
  use association _Travel { with draft; }
}